APP_NAME="PRUM AI Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Lightsail Managed Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=your-lightsail-db.xxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=prum_ai_academy
DB_USERNAME=admin
DB_PASSWORD=
# TLS が必要な場合:
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# アップロード（アバター・クエスト提出物）→ S3
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=ai-academy-prd
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_S3_TEMPORARY_URL=true
AWS_S3_TEMPORARY_URL_MINUTES=60

MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# 本番では必ず false
DB_FRESH=false
RUN_SEEDER=false

# コンテナ起動時の MySQL 待機（秒 = attempts × delay）
DB_WAIT_ATTEMPTS=30
DB_WAIT_DELAY=2

# Lightsail Container Service の公開ポート（LB からの転送先）
PORT=80

VITE_APP_NAME="${APP_NAME}"
